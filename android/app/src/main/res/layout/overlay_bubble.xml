<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/bubblePanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble"
        android:contentDescription="@string/overlay_avatar_cd"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubbleBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/companion_name"
            android:textColor="@color/blush"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubbleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/foam"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|start"
        android:layout_marginTop="72dp">

        <com.pangchuang.app.Live2DAvatarView
            android:id="@+id/fab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/overlay_avatar_cd"
            android:elevation="10dp" />

        <ImageButton
            android:id="@+id/overlayClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_overlay_close"
            android:contentDescription="@string/overlay_close_cd"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_close" />
    </FrameLayout>
</FrameLayout>
