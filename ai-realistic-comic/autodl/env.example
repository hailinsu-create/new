# Copy to .env on the AutoDL instance (optional; run_smoke.sh exports these).
IMAGE_PROVIDER=local
LOCAL_STILL_MODEL=qwen-image-edit-2511
# Fallback if Qwen OOM on 24GB: LOCAL_STILL_MODEL=flux2-klein-4b
LOCAL_CANDIDATES=1
LOCAL_STEPS=40
LOCAL_HEIGHT=1280
LOCAL_WIDTH=960
LOCAL_DTYPE=bfloat16
COMIC_QA=0
COMIC_ANATOMY_AUDIT=0
COMIC_STRICT_AUDIT=0
HF_HOME=/root/autodl-tmp/hf
