# Local Diffusers on the GPU box
IMAGE_PROVIDER=local
LOCAL_STILL_MODEL=qwen-image-edit-2511
LOCAL_CANDIDATES=1
LOCAL_STEPS=40
LOCAL_HEIGHT=1280
LOCAL_WIDTH=960
LOCAL_DTYPE=bfloat16
COMIC_QA=0
COMIC_ANATOMY_AUDIT=0
COMIC_STRICT_AUDIT=0
HF_HOME=/root/autodl-tmp/hf

# On your laptop / Cursor (comic autodl run)
AUTODL_TOKEN=
AUTODL_INSTANCE_UUID=
AUTODL_GPU_SPEC=4090D
AUTODL_IMAGE_UUID=base-image-l2t43iu6uk
AUTODL_AUTO_STOP=1
AUTODL_GIT_BRANCH=cursor/ai-realistic-comic-e63b
# Or SSH into an already-running instance:
# AUTODL_SSH_HOST=
# AUTODL_SSH_PORT=
# AUTODL_SSH_PASSWORD=
HF_ENDPOINT=https://hf-mirror.com
