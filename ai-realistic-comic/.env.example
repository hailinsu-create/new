# Real fal generation is the default. Use COMIC_MOCK=1 only for offline CI.
COMIC_MOCK=0

# Required for fal mode: https://fal.ai/dashboard/keys
FAL_KEY=

# Text-to-image for look sheets / panels without reference
FAL_T2I_MODEL=fal-ai/flux/dev
# Character-locked panels (needs reference_images on the character)
FAL_PULID_MODEL=fal-ai/flux-pulid

FAL_IMAGE_SIZE=portrait_4_3
FAL_ID_WEIGHT=1.0
FAL_GUIDANCE_SCALE=4.0
FAL_NUM_INFERENCE_STEPS=28
FAL_ENABLE_SAFETY_CHECKER=true

# Optional: storyboard LLM (falls back to built-in mock episode if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
