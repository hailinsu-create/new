# Real generation by default. COMIC_MOCK=1 only for offline CI.
COMIC_MOCK=0

# fal (default now) | comfy (AutoDL / self-host later)
IMAGE_PROVIDER=fal

# --- fal ---
# https://fal.ai/dashboard/keys
FAL_KEY=
FAL_T2I_MODEL=fal-ai/flux/dev
FAL_PULID_MODEL=fal-ai/flux-pulid
FAL_IMAGE_SIZE=portrait_4_3
FAL_ID_WEIGHT=1.0
FAL_GUIDANCE_SCALE=4.0
FAL_NUM_INFERENCE_STEPS=28
FAL_ENABLE_SAFETY_CHECKER=true

# --- comfy (scaffold; fill when AutoDL is ready) ---
# COMFY_API_URL=http://127.0.0.1:8188
# COMFY_WORKFLOW_PATH=workflows/pulid_api.json
# COMFY_CLIENT_ID=ai-realistic-comic

# Optional storyboard LLM (built-in mock episode if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
