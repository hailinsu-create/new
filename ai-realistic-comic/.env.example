# Set COMIC_MOCK=1 to run without paid APIs (CI / local smoke).
COMIC_MOCK=1

# fal.ai image generation
FAL_KEY=

# OpenAI-compatible chat for storyboard planning
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional fal model id override
FAL_IMAGE_MODEL=fal-ai/flux/dev
