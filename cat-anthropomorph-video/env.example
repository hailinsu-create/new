# cat-anthropomorph-video · environment example (SFW)
# Copy to .env on the GPU box. Do not commit secrets.

# ComfyUI install root on AutoDL (example paths — adjust)
COMFYUI_ROOT=/root/ComfyUI
MODELS_ROOT=/root/ComfyUI/models

# Persistent data disk for inputs/outputs (keep across stop; do not delete when powering off)
INPUT_ROOT=/root/autodl-tmp/cat-anthro/input
OUTPUT_ROOT=/root/autodl-tmp/cat-anthro/output

# Soft spend reminder (CNY). Scripts only warn; they do not recharge or boot.
SPEND_CAP_CNY=6

# Dual-race instance IDs (母机 / 克隆). Fill after you create them — do not claim already rented.
# AUTODL_INSTANCE_PRIMARY=
# AUTODL_INSTANCE_CLONE=
# AUTODL_REGION=

# Hugging Face download (optional token for rate limits)
# HF_TOKEN=

# Isolation guard: must NOT point at comic/NSFW trees
# FORBIDDEN_PREFIX=/root/ai-realistic-comic
