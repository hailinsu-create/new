{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/force-grok-cli.py",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/force-grok-cli.py",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/force-grok-cli.py",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/force-grok-cli.py",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/force-grok-cli.py",
        "timeout": 10
      }
    ]
  }
}
