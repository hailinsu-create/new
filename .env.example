# UI
BRAND_NAME=旁窗
PHONE_WIDTH=240
ALWAYS_ON_TOP=1

# Stream: auto | mock | adb
MODE=auto
PREVIEW_FPS=3
ADB_SERIAL=

# Roast
ROAST_INTERVAL_SEC=18
ROAST_CHANGE_THRESHOLD=8.0
# Set MOCK_API=1 to force local jokes even if a key is present
MOCK_API=0

# OpenAI-compatible vision endpoint (Qwen-VL, Ollama, etc.)
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
